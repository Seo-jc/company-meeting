{
  "name": "company-meeting",
  "version": "1.12.1",
  "description": "사내 화상회의 데스크톱 앱",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && tsc -p electron/tsconfig.json && electron .",
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "npm run build:renderer && npm run build:electron",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "release": "node scripts/release.cjs",
    "lint": "eslint src --max-warnings=999"
  },
  "dependencies": {
    "@tiptap/core": "^3.32.1",
    "@tiptap/extension-bold": "^3.32.1",
    "@tiptap/extension-collaboration": "^3.32.1",
    "@tiptap/extension-document": "^3.32.1",
    "@tiptap/extension-hard-break": "^3.32.1",
    "@tiptap/extension-italic": "^3.32.1",
    "@tiptap/extension-paragraph": "^3.32.1",
    "@tiptap/extension-placeholder": "^3.32.1",
    "@tiptap/extension-text": "^3.32.1",
    "@tiptap/extension-text-style": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/react": "^3.32.1",
    "@tiptap/y-tiptap": "^3.0.11",
    "electron-updater": "^6.3.9",
    "exceljs": "4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.0",
    "dotenv": "^16.4.5",
    "electron": "^33.4.11",
    "electron-builder": "^25.0.5",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.60.1",
    "vite": "^5.4.1",
    "wait-on": "^8.0.0"
  }
}
